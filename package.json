    "type": "git",
    "url": "git+https://github.com/WyattJHayes/dsh-feishu-channel.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "feishu",
    "lark",
    "channel"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
